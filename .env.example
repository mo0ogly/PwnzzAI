# JuiceLab Coach pour PwnzzAI — configuration.
# Copier en .env :  cp .env.example .env

# --- Modeles Ollama ---
# Modele des labs (assistant vulnerable). Petit = rapide.
OLLAMA_MODEL=llama3.2:1b
# Modele du juge / indices. 1b non fiable : minimum 3b conseille.
COACH_JUDGE_MODEL=llama3.2:3b

# --- Lien cohorte vers le dashboard prof JuiceLab ---
# URL du dashboard vue DEPUIS le conteneur. Defaut = dashboard sur la meme
# machine (cas le plus courant en TD).
#   meme machine : http://host.docker.internal:5000  (defaut ci-dessous)
#   distant      : http://<ip-ou-domaine-prof>:5000
#   vide         : mode local, aucune remontee (le coach marche quand meme)
JUICELAB_DASHBOARD_URL=http://host.docker.internal:5000
# Identifiant de cohorte (regroupe les eleves dans le dashboard).
JUICELAB_COHORT_ID=M2-IA-2026
# Nom de ce poste dans la matrice du prof.
JUICELAB_INSTANCE_LABEL=pwnzzai-poste-01

# --- Avance ---
# Commit OWASP/PwnzzAI fige contre lequel le coach est teste. Bumper pour
# suivre l'upstream (puis revalider labs.json).
PWNZZAI_COMMIT=676b9cf7e924e8a3bd9711a507887acebd2d8c52

# --- Deploiement du dashboard prof (optionnel) ---
# Si tu deploies le dashboard central DEPUIS cette machine via
# scripts/deploy-dashboard.sh : ref (SHA conseille) du repo juicelab dont on
# tire la partie prof. Laisse vide si le dashboard tourne deja ailleurs.
JUICELAB_DASHBOARD_REF=main
# URL du repo juicelab (source de la partie prof, sparse checkout).
JUICELAB_REPO_URL=https://github.com/mo0ogly/juicelab.git
