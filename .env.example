# JuiceLab Coach pour PwnzzAI — configuration.
# Copier en .env :  cp .env.example .env

# --- Modeles Ollama ---
# Modele des labs (assistant vulnerable). Petit = rapide.
OLLAMA_MODEL=llama3.2:1b
# Modele du juge / indices. 1b non fiable : minimum 3b conseille.
COACH_JUDGE_MODEL=llama3.2:3b

# --- Backend LLM de la CIBLE (produit OWASP, labs cloud openai_*) ---
# Defaut : ollama (100% local, offline). Le produit OWASP est bati sur LiteLLM
# et gere de nombreux fournisseurs nativement -> AUCUNE modif de son code, juste
# ces vars. MODEL_PROVIDER=openai signifie "cloud via LiteLLM" (pas forcement
# OpenAI) ; le prefixe de LITELLM_MODEL avant le "/" choisit le vrai fournisseur.
# Fournisseurs supportes (exemple worked = Groq ci-dessous) :
#   Groq      : LITELLM_MODEL=groq/openai/gpt-oss-20b        + GROQ_API_KEY
#   OpenAI    : LITELLM_MODEL=openai/gpt-4o-mini             + OPENAI_API_KEY
#   Gemini    : LITELLM_MODEL=gemini/gemini-2.0-flash        + GEMINI_API_KEY
#   Anthropic : LITELLM_MODEL=anthropic/claude-3-5-haiku-latest + ANTHROPIC_API_KEY
# Pour basculer la cible sur Groq (cloud, rapide, plus fiable) : decommenter les
# trois lignes du bas et coller ta cle.
#   MODEL_PROVIDER=openai
#   LITELLM_MODEL=groq/openai/gpt-oss-20b   # cible : 20b suffit (cheap/rapide). 120b si tu veux +
#   GROQ_API_KEY=gsk_xxx                    # cle Groq, JAMAIS committee (.env est gitignore)
# Cout indicatif (Groq) : ~1-3 EUR / matinee / 10 eleves. Active pay-as-you-go +
# spend limit sur https://console.groq.com . Resiste aux MAJ upstream (commit OWASP pinne).
# NB modeles reasoning : gpt-oss-20b/120b avec un max_tokens trop petit renvoient
# du VIDE (finish_reason=length). 20b suffit ; sinon modele non-reasoning
# (groq/llama-3.3-70b-versatile) pour zero surprise.
MODEL_PROVIDER=ollama
# LITELLM_MODEL=groq/openai/gpt-oss-20b
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Lien cohorte vers le dashboard prof JuiceLab ---
# URL du dashboard vue DEPUIS le conteneur. Defaut = dashboard sur la meme
# machine (cas le plus courant en TD).
#   meme machine : http://host.docker.internal:5000  (defaut ci-dessous)
#   distant      : http://<ip-ou-domaine-prof>:5000
#   vide         : mode local, aucune remontee (le coach marche quand meme)
JUICELAB_DASHBOARD_URL=http://host.docker.internal:5000
# Identifiant de cohorte (regroupe les eleves dans le dashboard).
JUICELAB_COHORT_ID=M2-IA-2026
# Nom de ce poste dans la matrice du prof.
JUICELAB_INSTANCE_LABEL=pwnzzai-poste-01

# --- Avance ---
# Commit OWASP/PwnzzAI fige contre lequel le coach est teste. Bumper pour
# suivre l'upstream (puis revalider labs.json).
PWNZZAI_COMMIT=676b9cf7e924e8a3bd9711a507887acebd2d8c52

# --- Deploiement du dashboard prof (optionnel) ---
# Si tu deploies le dashboard central DEPUIS cette machine via
# scripts/deploy-dashboard.sh : ref (SHA conseille) du repo juicelab dont on
# tire la partie prof. Laisse vide si le dashboard tourne deja ailleurs.
JUICELAB_DASHBOARD_REF=main
# URL du repo juicelab (source de la partie prof, sparse checkout).
JUICELAB_REPO_URL=https://github.com/mo0ogly/juicelab.git
